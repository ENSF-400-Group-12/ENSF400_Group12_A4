# Copy to ".env" at the repo root (UTF-8, no BOM). Restart backend after changes.

PORT=8080
NODE_ENV=development

# Required in production (min 32 chars). In local dev, omit to use an ephemeral secret (sessions reset on restart).
SESSION_SECRET=

# Behind reverse proxy + HTTPS: TRUST_PROXY=1. Force cookie flags: SESSION_COOKIE_SECURE=0 for plain HTTP labs.
# TRUST_PROXY=1
# SESSION_COOKIE_SECURE=1

# Optional: comma-separated origins for credentialed browser requests
# FRONTEND_ORIGIN=http://localhost:13000,http://localhost:3000

# Optional: override local filesystem (staging with persistent disk)
# CLOSETAI_DATA_DIR=/data/closetai
# CLOSETAI_UPLOAD_DIR=/data/closetai/uploads
# CLOSETAI_DATABASE_PATH=/data/closetai/app.db

# CI / hosting: commit shown in boot log (optional)
# GIT_COMMIT_SHA=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_OUTFIT_RERANK=1
