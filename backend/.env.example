# Copy to repo root .env or backend/.env (see backend/lib/loadEnv.js load order).
# Never commit real secrets.

NODE_ENV=development
PORT=8080

# Bind address (0.0.0.0 is typical for Railway and containers)
LISTEN_HOST=0.0.0.0

# Session (required in production; min 32 chars when NODE_ENV=production)
SESSION_SECRET=

# Behind reverse proxy (Railway, etc.)
TRUST_PROXY=0
SESSION_COOKIE_SECURE=0

# CORS: comma-separated origins (Vercel frontend URL in production)
FRONTEND_ORIGIN=http://localhost:3000

# Public frontend URL for auth email links
APP_BASE_URL=http://localhost:3000

# Persistent storage (point both at a Railway volume path in production, e.g. under /data)
CLOSETAI_DATA_DIR=
CLOSETAI_DATABASE_PATH=
CLOSETAI_UPLOAD_DIR=

# OpenAI (optional for local; required for vision / rerank features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_OUTFIT_RERANK=0

# Mailer (see docs/AUTH-EMAIL-SETUP.md)
MAILER_MODE=log
MAIL_FROM=
RESEND_API_KEY=
