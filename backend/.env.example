# Copy to backend/.env and/or repo root .env (both are loaded: backend first, then parent).

PORT=8080
SESSION_SECRET=change-me-in-production

# Optional: OpenAI (item image analysis + outfit rerank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional timeouts (ms)
# OPENAI_ANALYZE_TIMEOUT_MS=25000
# OPENAI_RERANK_TIMEOUT_MS=20000
# Set to 0 to skip outfit rerank even when API key is set
# OPENAI_OUTFIT_RERANK=0

# CORS (comma-separated). Playwright uses 13000; dev often uses 3000.
# FRONTEND_ORIGIN=http://localhost:13000,http://localhost:3000
