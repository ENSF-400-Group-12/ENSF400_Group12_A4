# Copy to backend/.env and/or repo root .env (both are loaded from repo root + backend).

PORT=8080
NODE_ENV=development

# Production: required, 32+ characters. Dev: omit for ephemeral secret (see docs/DEPLOYMENT.md).
SESSION_SECRET=

# TRUST_PROXY=1
# SESSION_COOKIE_SECURE=1

# CLOSETAI_DATA_DIR=
# CLOSETAI_UPLOAD_DIR=
# CLOSETAI_DATABASE_PATH=

# GIT_COMMIT_SHA=

# Optional: OpenAI (item image analysis + outfit rerank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ANALYZE_TIMEOUT_MS=25000
# OPENAI_RERANK_TIMEOUT_MS=20000
# OPENAI_OUTFIT_RERANK=0

# FRONTEND_ORIGIN=http://localhost:13000,http://localhost:3000
