# Server
PORT=8080

# Session (use a long random string in production)
SESSION_SECRET=change-me-in-production

# CORS: allowed frontend origin(s). Comma-separated for multiple (e.g. local dev on 3000 and 3001).
# If unset, allows http://localhost:3000 and http://localhost:3001
# FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
